# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the anon/publishable key belongs here: it is safe in the browser because
# row level security governs what it can reach. The service role key must never
# appear in this file, in the repo, or in any VITE_ variable — Vite inlines
# those into the client bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
